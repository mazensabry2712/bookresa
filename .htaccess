<IfModule mod_rewrite.c>
    RewriteEngine On

    # Emergency-safe root front-controller rewrite:
    # Never rewrite a URL that already targets the physical public directory.
    # This prevents repeated internal rewrites such as /login -> public/login
    # -> public/public/login. Canonical /public redirects are intentionally
    # disabled here until the Hostinger CDN cache is purged and verified.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
