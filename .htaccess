<IfModule mod_dir.c>
    # Prevent Apache from appending a slash before canonicalizing /public.
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteOptions AllowNoSlash

    # Redirect direct client requests for /public to the domain root.
    # THE_REQUEST is unchanged by internal rewrites, avoiding /login loops.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/?]|\s) [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=302,L,NE]

    # Do not internally rewrite requests that have already entered /public.
    # This prevents public/public/... loops after the root rewrite.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
