<IfModule mod_alias.c>
    # Redirect the physical public directory before Apache adds its trailing slash.
    RedirectMatch 301 ^/public/?$ /
    RedirectMatch 301 ^/public/(.*)$ /$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the Laravel public directory at the domain root.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
